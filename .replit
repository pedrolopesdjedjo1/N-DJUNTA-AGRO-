modules = ["nodejs-20", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "dbus", "atk", "cups", "cairo", "gtk3", "mesa"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 4040
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
