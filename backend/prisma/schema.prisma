// Schema do banco de dados - NôdjuntaAgro GB
// Rode: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tipos de perfil de usuário do app
enum UserRole {
  AGRICULTOR
  PESCADOR
  COMPRADOR
  COMERCIANTE
  AGENTE_DIGITAL
  TRANSPORTADOR
  GOVERNO
  ONG
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole
  location  String?
  preferredLanguage Language @default(PORTUGUES)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products         Product[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reviewsGiven    Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")
  notifications Notification[]
  favorites Favorite[]
  reportsMade Report[]
  transportOffers TransportOffer[]
  purchasesMade Payment[] @relation("Buyer")
  salesReceived Payment[] @relation("Seller")
  isVerified   Boolean               @default(false)
  verifications VerificationRequest[]
  alertsCreated WeatherAlert[]
  cooperativesLed Cooperative[]
  cooperativeMemberships CooperativeMember[]
  @@map("users")
}
enum ProductCategory {
  AGRICOLA
  PESCA
  ARTESANATO
  OUTRO
}

model Product {
  id          String          @id @default(uuid())
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id])
  title       String
  description String?
  category    ProductCategory
  price       Float
  unit        String
  quantity    Int
  location    String?
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    Message[]
  reviews     Review[]
  favoritedBy Favorite[]
  @@map("products")
}
model Message {
  id         String    @id @default(uuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  content    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@map("messages")
}
model Review {
  id         String   @id @default(uuid())
  authorId   String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId   String
  target     User     @relation("ReviewTarget", fields: [targetId], references: [id])
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@map("reviews")
}
enum NotificationType {
  MENSAGEM
  AVALIACAO
  PRODUTO
  SISTEMA
}
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  relatedId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}
enum ReportTargetType {
  USER
  PRODUCT
}

enum ReportStatus {
  PENDENTE
  EM_ANALISE
  RESOLVIDA
  REJEITADA
}

model Report {
  id         String           @id @default(uuid())
  reporterId String
  reporter   User             @relation(fields: [reporterId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(PENDENTE)
  createdAt  DateTime         @default(now())

  @@map("reports")
}
model TransportOffer {
  id            String   @id @default(uuid())
  transporterId String
  transporter   User     @relation(fields: [transporterId], references: [id])
  origin        String
  destination   String
  capacity      String
  price         Float
  availableDate DateTime
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("transport_offers")
}
enum PaymentMethod {
  DINHEIRO
  TRANSFERENCIA
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

model Payment {
  id        String        @id @default(uuid())
  buyerId   String
  buyer     User          @relation("Buyer", fields: [buyerId], references: [id])
  sellerId  String
  seller    User          @relation("Seller", fields: [sellerId], references: [id])
  productId String?
  amount    Float
  method    PaymentMethod
  status    PaymentStatus @default(PENDENTE)
  notes     String?
  createdAt DateTime      @default(now())
  feeAmount Float?
  netAmount Float?
  @@map("payments")
}
enum Language {
  PORTUGUES
  CRIOULO
}

model Translation {
  id        String   @id @default(uuid())
  key       String   @unique
  portugues String
  crioulo   String
  updatedAt DateTime @updatedAt

  @@map("translations")
}

enum SmsDirection {
  RECEBIDO
  ENVIADO
}

model SmsLog {
  id        String       @id @default(uuid())
  phone     String
  direction SmsDirection
  message   String
  createdAt DateTime     @default(now())

  @@map("sms_logs")
}
enum VerificationStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

model VerificationRequest {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  documentType String
  documentNote String?
  status       VerificationStatus @default(PENDENTE)
  createdAt    DateTime           @default(now())

  @@map("verification_requests")
}

enum AlertType {
  CHUVA
  SECA
  PRAGA
  OUTRO
}

enum AlertSeverity {
  BAIXA
  MEDIA
  ALTA
}

model WeatherAlert {
  id          String        @id @default(uuid())
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  region      String
  type        AlertType
  severity    AlertSeverity
  title       String
  description String
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  @@map("weather_alerts")
}
model Cooperative {
  id          String              @id @default(uuid())
  name        String
  description String?
  region      String
  leaderId    String
  leader      User                @relation(fields: [leaderId], references: [id])
  members     CooperativeMember[]
  createdAt   DateTime            @default(now())

  @@map("cooperatives")
}

model CooperativeMember {
  id            String      @id @default(uuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  joinedAt      DateTime    @default(now())

  @@unique([cooperativeId, userId])
  @@map("cooperative_members")
}

