// Schema do banco de dados - NôdjuntaAgro GB
// Rode: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tipos de perfil de usuário do app
enum UserRole {
  AGRICULTOR
  PESCADOR
  COMPRADOR
  COMERCIANTE
  AGENTE_DIGITAL
  TRANSPORTADOR
  GOVERNO
  ONG
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole
  location  String?
  preferredLanguage Language @default(PORTUGUES)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products         Product[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reviewsGiven    Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")
  notifications Notification[]
  favorites Favorite[]
  reportsMade Report[]
  transportOffers TransportOffer[]
  purchasesMade Payment[] @relation("Buyer")
  salesReceived Payment[] @relation("Seller")
  isVerified   Boolean               @default(false)
  failedLoginAttempts Int            @default(0) @map("failedLoginAttemt")
  lockedUntil  DateTime?
  verifications VerificationRequest[]
  alertsCreated WeatherAlert[]
  cooperativesLed Cooperative[]
  cooperativeMemberships CooperativeMember[]
  @@map("users")
}
enum ProductCategory {
  AGRICOLA
  PESCA
  ARTESANATO
  OUTRO
}

model Product {
  id          String          @id @default(uuid())
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id])
  title       String
  description String?
  category    ProductCategory
  price       Float
  unit        String
  quantity    Int
  location    String?
  imageUrl    String?
  videoUrl    String?
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    Message[]
  reviews     Review[]
  favoritedBy Favorite[]
  // --- campos usados pelo código (acrescentados) ---
  department String?
  details Json?
  orderItems OrderItem[]
  @@map("products")
}
model Message {
  id         String    @id @default(uuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  content    String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@map("messages")
}
model Review {
  id         String   @id @default(uuid())
  authorId   String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId   String
  target     User     @relation("ReviewTarget", fields: [targetId], references: [id])
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@map("reviews")
}
enum NotificationType {
  MENSAGEM
  AVALIACAO
  PRODUTO
  SISTEMA
}
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  relatedId String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}
enum ReportTargetType {
  USER
  PRODUCT
}

enum ReportStatus {
  PENDENTE
  EM_ANALISE
  RESOLVIDA
  REJEITADA
}

model Report {
  id         String           @id @default(uuid())
  reporterId String
  reporter   User             @relation(fields: [reporterId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(PENDENTE)
  createdAt  DateTime         @default(now())

  @@map("reports")
}
model TransportOffer {
  id            String   @id @default(uuid())
  transporterId String
  transporter   User     @relation(fields: [transporterId], references: [id])
  origin        String
  destination   String
  capacity      String
  price         Float
  availableDate DateTime
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  // --- campos usados pelo código (acrescentados) ---
  status String?
  departureDate DateTime?
  @@map("transport_offers")
}
enum PaymentMethod {
  DINHEIRO
  TRANSFERENCIA
  MOBILE_MONEY
}

enum PaymentStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

model Payment {
  id        String        @id @default(uuid())
  buyerId   String
  buyer     User          @relation("Buyer", fields: [buyerId], references: [id])
  sellerId  String
  seller    User          @relation("Seller", fields: [sellerId], references: [id])
  productId String?
  amount    Float
  method    PaymentMethod
  status    PaymentStatus @default(PENDENTE)
  notes     String?
  createdAt DateTime      @default(now())
  feeAmount Float?
  netAmount Float?
  @@map("payments")
}
enum Language {
  PORTUGUES
  CRIOULO
}

model Translation {
  id        String   @id @default(uuid())
  key       String   @unique
  portugues String
  crioulo   String
  updatedAt DateTime @updatedAt

  @@map("translations")
}

enum SmsDirection {
  RECEBIDO
  ENVIADO
}

model SmsLog {
  id        String       @id @default(uuid())
  phone     String
  direction SmsDirection
  message   String
  createdAt DateTime     @default(now())

  @@map("sms_logs")
}
enum VerificationStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

model VerificationRequest {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  documentType String
  documentNote String?
  status       VerificationStatus @default(PENDENTE)
  createdAt    DateTime           @default(now())

  @@map("verification_requests")
}

enum AlertType {
  CHUVA
  SECA
  PRAGA
  OUTRO
}

enum AlertSeverity {
  BAIXA
  MEDIA
  ALTA
}

model WeatherAlert {
  id          String        @id @default(uuid())
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  region      String
  type        AlertType
  severity    AlertSeverity
  title       String
  description String
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  @@map("weather_alerts")
}
model Cooperative {
  id          String              @id @default(uuid())
  name        String
  description String?
  region      String
  leaderId    String
  leader      User                @relation(fields: [leaderId], references: [id])
  members     CooperativeMember[]
  createdAt   DateTime            @default(now())

  // --- campos usados pelo código (acrescentados) ---
  posts CommunityPost[]
  @@map("cooperatives")
}

model CooperativeMember {
  id            String      @id @default(uuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  joinedAt      DateTime    @default(now())

  @@unique([cooperativeId, userId])
  @@map("cooperative_members")
}
model PlatformSettings {
  id                    String   @id @default(uuid())
  commissionPercentage  Float    @default(0)
  updatedAt             DateTime @updatedAt

  @@map("platform_settings")
}
model UserSanction {
  id String @id @default(uuid())
  userId String
  status String @default("")
  endedAt DateTime?
  endedBy String?
  endNote String?
  hiddenProductIds String[]
  kind String
  endsAt DateTime
  reason String
  reportId String
  createdBy String
  role String?
  createdAt DateTime @default(now())
  @@map("user_sanctions")
}

model AgentClient {
  id String @id @default(uuid())
  agentId String
  status String
  clientId String
  origin String
  consentMode String
  consentAt DateTime?
  notes String
  endedAt DateTime?
  endedBy String?
  lastContactAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([agentId,clientId])
  @@map("agent_clients")
}

model Order {
  id String @id @default(uuid())
  buyerId String?
  sellerId String?
  total Float @default(0)
  status String @default("")
  paid Boolean @default(false)
  deliveryOption String?
  deliveryAddress String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  items OrderItem[]
  delivery Delivery?
  @@map("orders")
}

model Organization {
  id String @id @default(uuid())
  ownerId String @unique
  name String
  logoUrl String?
  verificationStatus String?
  institutionType String?
  phone String
  region String
  verificationSubmittedAt DateTime?
  verificationNote String?
  verificationReviewedAt DateTime?
  acronym String?
  description String?
  areas String[]
  address String?
  email String?
  website String?
  facebook String?
  instagram String?
  whatsapp String?
  foundedYear Int @default(0)
  parentInstitution String?
  @@map("organizations")
}

model PlatformSetting {
  id String @id @default(uuid())
  key String @unique
  value Json
  updatedBy String
  @@map("platform_settings_kv")
}

model AgentSession {
  id String @id @default(uuid())
  actions Int @default(0)
  agentId String
  endedAt DateTime?
  expiresAt DateTime
  startedAt DateTime?
  clientId String
  linkId String
  reason String
  @@map("agent_sessions")
}

model AgentProfile {
  id String @id @default(uuid())
  userId String @unique
  status String @default("")
  commissionRate Float @default(0)
  agentType String?
  regions String[]
  serviceAddress String?
  serviceLat Float @default(0)
  serviceLng Float @default(0)
  schedule String?
  lockedAt DateTime?
  lockReason String?
  canRegister Boolean @default(false)
  canAssist Boolean @default(false)
  reviewedAt DateTime?
  reviewedBy String?
  submittedAt DateTime?
  statusNote String?
  whatsapp String?
  areas String[]
  bio String?
  createdAt DateTime @default(now())
  @@map("agent_profiles")
}

model AgentActivity {
  id String @id @default(uuid())
  agentId String
  clientId String?
  kind String
  message String
  relatedId String?
  isPrivate Boolean @default(false)
  createdAt DateTime @default(now())
  @@map("agent_activities")
}
model UserAddress {
  id String @id @default(uuid())
  userId String
  isDefault Boolean @default(false)
  label String
  name String?
  address String
  region String?
  lat Float?
  lng Float?
  createdAt DateTime @default(now())
  @@map("user_addresses")
}

model AdminProfile {
  id String @id @default(uuid())
  userId String @unique
  level String
  createdBy String
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  backupCodes String[]
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  title String @default("")
  extraPermissions String[]
  deniedPermissions String[]
  previousRole String?
  status String @default("")
  statusNote String?
  @@map("admin_profiles")
}

model AdminAudit {
  id String @id @default(uuid())
  adminId String
  action String
  targetType String
  targetId String
  summary String
  meta Json
  adminName String?
  createdAt DateTime @default(now())
  @@map("admin_audits")
}

model AdminSecurityEvent {
  id String @id @default(uuid())
  adminId String
  kind String
  message String
  ip String
  userAgent String
  severity String
  createdAt DateTime @default(now())
  @@map("admin_security_events")
}

model AdminBroadcast {
  id String @id @default(uuid())
  createdBy String
  kind String
  title String
  message String
  audiences String[]
  regionKeys String[]
  severity String
  endsAt DateTime?
  sentCount Int
  isAlert Boolean
  endedAt DateTime?
  endedBy String?
  createdAt DateTime @default(now())
  @@map("admin_broadcasts")
}

model OfficialAlert {
  id String @id @default(uuid())
  startsAt DateTime?
  title String @default("")
  severity String?
  kind String @default("")
  regions String[]
  isActive Boolean @default(false)
  expiresAt DateTime?
  ownerId String?
  audience String?
  notifiedCount Int @default(0)
  createdAt DateTime @default(now())
  @@map("official_alerts")
}

model Banner {
  id String @id @default(uuid())
  sortOrder Int @default(0)
  isActive Boolean @default(false)
  endsAt DateTime?
  createdBy String?
  startsAt DateTime?
  regionKeys String[]
  title String @default("")
  audiences String[]
  createdAt DateTime @default(now())
  @@map("banners")
}

model Highlight {
  id String @id @default(uuid())
  endsAt DateTime
  kind String
  label String
  refId String
  createdBy String
  startsAt DateTime?
  @@map("highlights")
}

model ContentVisibility {
  id String @id @default(uuid())
  kind String
  refId String
  hidden Boolean
  reason String
  hiddenBy String
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([kind,refId])
  @@map("content_visibilities")
}

model CooperativeReview {
  id String @id @default(uuid())
  cooperativeId String @unique
  status String
  note String
  reviewedBy String
  reviewedAt DateTime?
  @@map("cooperative_reviews")
}

model NgoProject {
  id String @id @default(uuid())
  status String @default("")
  ownerId String?
  endDate DateTime?
  name String @default("")
  isPublic Boolean @default(false)
  area Float @default(0)
  region String?
  startDate DateTime?
  budget Float @default(0)
  targetBeneficiaries String?
  coverUrl String?
  lat Float?
  lng Float?
  description String?
  focus String?
  updatedAt DateTime @default(now()) @updatedAt
  @@map("ngo_projects")
}
model Delivery {
  id String @id @default(uuid())
  status String @default("")
  transporterId String?
  orderId String? @unique
  lastLocationAt DateTime?
  lastLocation String?
  lastLat Float?
  lastLng Float?
  price Float @default(0)
  pickupAt DateTime?
  createdAt DateTime @default(now())
  order Order? @relation(fields: [orderId], references: [id])
  @@map("deliveries")
}

model DeliveryEvent {
  id String @id @default(uuid())
  kind String
  deliveryId String
  actorId String
  message String
  category String @default("")
  lat Float?
  lng Float?
  photoUrl String?
  createdAt DateTime @default(now())
  @@map("delivery_events")
}

model GovProgram {
  id String @id @default(uuid())
  status String @default("")
  ownerId String?
  endDate DateTime?
  name String @default("")
  isPublic Boolean @default(false)
  regions String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("gov_programs")
}

model IdentityVerification {
  id String @id @default(uuid())
  status String @default("")
  userId String
  documentKind String
  documentUrl String
  selfieUrl String
  note String
  reviewNote String?
  reviewedAt DateTime?
  reviewedBy String?
  createdAt DateTime @default(now())
  @@map("identity_verifications")
}

model TransporterProfile {
  id String @id @default(uuid())
  verificationStatus String?
  isAvailable Boolean @default(false)
  userId String @unique
  emergencyContacts String?
  vehicleStatus String?
  vehicleStatusNote String?
  notifyNewLoads Boolean @default(false)
  vehicleType String?
  submittedAt DateTime?
  verificationNote String?
  reviewedAt DateTime?
  reviewedBy String?
  regions String[]
  transporterKind String?
  vehicleBrand String?
  vehicleModel String?
  vehicleYear Int @default(0)
  vehiclePhotos String[]
  cargoTypes String[]
  capacityKg Float @default(0)
  bio String?
  @@map("transporter_profiles")
}

model AgentCase {
  id String @id @default(uuid())
  status String @default("")
  orderId String?
  agentId String
  clientId String
  category String
  title String
  description String
  resolution String?
  resolvedAt DateTime?
  escalatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("agent_cases")
}

model AgentSecurityReport {
  id String @id @default(uuid())
  status String @default("")
  reporterId String
  targetUserId String?
  kind String
  description String
  adminNote String?
  createdAt DateTime @default(now())
  @@map("agent_security_reports")
}

model ContentReport {
  id String @id @default(uuid())
  status String @default("")
  targetType String
  targetId String?
  decision String?
  decisionNote String?
  decidedBy String?
  decidedAt DateTime?
  reporterId String
  reportedUserId String?
  category String
  description String
  assignedTo String?
  createdAt DateTime @default(now())
  @@map("content_reports")
}

model OrderDisputeEvent {
  id String @id @default(uuid())
  disputeId String
  authorId String
  kind String
  message String
  createdAt DateTime @default(now())
  @@map("order_dispute_events")
}

model OrderDispute {
  id String @id @default(uuid())
  orderId String
  status String @default("")
  openedBy String
  reason String
  description String
  againstId String
  assignedTo String?
  decision String?
  decisionNote String?
  refundAmount Float @default(0)
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  @@map("order_disputes")
}

model OrderPayment {
  id String @id @default(uuid())
  orderId String
  status String @default("")
  buyerId String
  method String
  amount Float
  reference String
  phone String
  createdAt DateTime @default(now())
  @@map("order_payments")
}

model Refund {
  id String @id @default(uuid())
  status String @default("")
  paidAt DateTime?
  amount Float
  orderId String
  disputeId String?
  buyerId String
  reason String
  requestedBy String
  decisionNote String?
  decidedBy String?
  decidedAt DateTime?
  paidNote String?
  paidBy String?
  createdAt DateTime @default(now())
  @@map("refunds")
}

model AgentCommission {
  id String @id @default(uuid())
  status String
  amount Float
  paidAt DateTime
  agentId String
  note String
  orderId String
  orderCompletedAt DateTime
  paidBy String
  createdAt DateTime @default(now())
  @@map("agent_commissions")
}

model OrderItem {
  id String @id @default(uuid())
  orderId String
  productId String?
  title String
  quantity Float
  unitPrice Float
  price Float
  order Order @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  @@map("order_items")
}

model FinanceFlagReview {
  id String @id @default(uuid())
  key String @unique
  note String
  reviewedBy String
  reviewedAt DateTime?
  @@map("finance_flag_reviews")
}

model PublicService {
  id String @id @default(uuid())
  isPublished Boolean @default(false)
  status String @default("")
  name String @default("")
  category String @default("")
  region String?
  address String?
  lat Float?
  lng Float?
  schedule String?
  ownerId String?
  statusNote String?
  createdAt DateTime @default(now())
  @@map("public_services")
}

model GovPlace {
  id String @id @default(uuid())
  kind String @default("")
  isPublic Boolean @default(false)
  region String?
  name String @default("")
  subtype String?
  lat Float?
  lng Float?
  status String @default("")
  schedule String?
  ownerId String?
  @@map("gov_places")
}

model Publication {
  id String @id @default(uuid())
  ownerId String?
  notifiedRegion Boolean @default(false)
  isPublished Boolean @default(false)
  region String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("publications")
}

model CitizenReport {
  id String @id @default(uuid())
  institutionId String?
  status String @default("")
  priority String?
  protocol String @unique
  category String
  title String
  region String
  requesterId String
  message String
  location String
  lat Float
  lng Float
  placeId String
  imageUrls String[]
  handledById String?
  answer String?
  resolvedAt DateTime?
  anonymous Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("citizen_reports")
}

model GovProgramProject {
  id String @id @default(uuid())
  programId String
  projectId String @unique
  createdAt DateTime @default(now())
  @@map("gov_program_projects")
}

model ProductModeration {
  id String @id @default(uuid())
  productId String? @unique
  status String @default("")
  wasAvailable Boolean?
  @@map("product_moderations")
}

model MarketCategory {
  id String @id @default(uuid())
  department String? @unique
  @@map("market_categories")
}

model OrderNote {
  id String @id @default(uuid())
  orderId String
  authorId String
  message String
  createdAt DateTime @default(now())
  @@map("order_notes")
}

model Opportunity {
  id String @id @default(uuid())
  status String @default("")
  ownerId String?
  deadline DateTime?
  title String @default("")
  createdAt DateTime @default(now())
  @@map("opportunities")
}

model OrganizationDocument {
  id String @id @default(uuid())
  organizationId String
  kind String
  name String
  url String
  createdAt DateTime @default(now())
  @@map("organization_documents")
}

model ContentReportEvent {
  id String @id @default(uuid())
  reportId String
  authorId String
  kind String
  message String
  createdAt DateTime @default(now())
  @@map("content_report_events")
}

model AdminSession {
  id String @id @default(uuid())
  adminId String
  tokenHash String
  revokedAt DateTime?
  expiresAt DateTime
  lastSeenAt DateTime?
  userAgent String
  method String
  ip String
  createdAt DateTime @default(now())
  @@map("admin_sessions")
}

model SupportTicketState {
  id String @id @default(uuid())
  ticketId String @unique
  status String
  updatedBy String
  assignedTo String
  updatedAt DateTime @default(now()) @updatedAt
  @@map("support_ticket_states")
}

model SupportReply {
  id String @id @default(uuid())
  ticketId String
  authorId String
  message String
  isInternal Boolean
  createdAt DateTime @default(now())
  @@map("support_replies")
}

model AgentRating {
  id String @id @default(uuid())
  authorId String
  agentId String
  rating Float
  comment String
  @@unique([agentId,authorId])
  @@map("agent_ratings")
}

model AgentNeed {
  id String @id @default(uuid())
  agentId String?
  status String @default("")
  regionKey String?
  forwardedAt DateTime?
  institutionId String?
  reportId String?
  protocol String?
  clientId String?
  category String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("agent_needs")
}

model AgentTask {
  id String @id @default(uuid())
  agentId String?
  status String @default("")
  doneAt DateTime?
  @@map("agent_tasks")
}
model Training {
  id String @id @default(uuid())
  ownerId String?
  status String @default("")
  startsAt DateTime?
  title String @default("")
  region String?
  location String?
  lat Float?
  lng Float?
  isOnline Boolean @default(false)
  endsAt DateTime?
  kind String @default("")
  projectId String?
  capacity Float @default(0)
  hours Int @default(0)
  @@map("trainings")
}

model AgentDocument {
  id String @id @default(uuid())
  agentId String
  kind String
  name String
  url String
  createdAt DateTime @default(now())
  @@map("agent_documents")
}

model EventRegistration {
  id String @id @default(uuid())
  userId String
  eventId String
  createdAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id])
  @@map("event_registrations")
}

model Store {
  id String @id @default(uuid())
  ownerId String? @unique
  name String @default("")
